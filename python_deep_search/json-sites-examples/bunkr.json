{
    "bunkr": {
        "base_url": "https://balbums.st",
        "search_template": "{base}/?search={query}",
        "use_full_path": false,
        "params": {
            "mode": "broad",
            "per": "100",
            "sort": "latest"
        },
        "follow": {
            "enabled": false,
            "collect_child_links": false
        }
    },
    "coomer": {
        "base_url": "https://official.coomer.com.co",
        "search_template": "{base}/search/{query}",
        "use_full_path": false,
        "params": null,
        "follow": {
            "enabled": false,
            "collect_child_links": false
        },
        "link_rules": {
            "search_strict_query": true,
            "exclude_url_patterns": [
                "^https://[^/]+/(de|ja|fr|es|it|pt|zh|ru|tr)/search/"
            ]
        }
    },
    "asmr1": {
        "base_url": "https://www.asmr1.cc",
        "search_template": "{base}/?person={query}",
        "use_full_path": false,
        "params": null,
        "follow": {
            "enabled": false,
            "collect_child_links": false
        }
    }
}