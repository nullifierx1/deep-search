{
  "turbo": {
    "base_url": "https://turbo.cr",
    "path_builder": { "pattern": "/library?page={n}", "start": 1, "end": 40, "step": 1 },
    "link_rules": {
      "search_strict_query": true,
      "include_url_patterns": ["^https://turbo\\.cr/a/[A-Za-z0-9_-]+/?$"],
      "exclude_url_patterns": []
    },
    "dedupe": { "strip_fragment": true, "strip_trailing_slash": true, "ignore_query": true },
    "follow": { "enabled": true, "collect_child_links": false },
    "anti_block": { "min_delay_sec": 0.8, "max_delay_sec": 1.5, "max_retries": 3, "retry_on_status": [429, 503], "use_cookies": true }
  },
  "asmr1": {
    "base_url": "https://www.asmr1.cc",
    "search_template": "{base}/?person={query}",
    "link_rules": {
      "search_strict_query": true,
      "include_url_patterns": ["^https://www\\.asmr1\\.cc/[^/?#]+/?$"],
      "exclude_url_patterns": []
    },
    "dedupe": { "strip_fragment": true, "strip_trailing_slash": true, "ignore_query": true },
    "follow": { "enabled": true, "collect_child_links": false },
    "anti_block": { "min_delay_sec": 0.6, "max_delay_sec": 1.2, "max_retries": 3, "retry_on_status": [429, 503], "use_cookies": true }
  },
  "91porna": {
    "base_url": "https://91porna.com",
    "search_template": "{base}/comic/index/search?keyword={query}",
    "link_rules": {
      "search_strict_query": false,
      "include_url_patterns": ["^https://91porna\\.com/comic/index/detail\\?video_key=\\d+$"],
      "exclude_url_patterns": []
    },
    "dedupe": { "strip_fragment": true, "ignore_query": false },
    "follow": { "enabled": true, "collect_child_links": false },
    "anti_block": { "min_delay_sec": 0.8, "max_delay_sec": 1.5, "max_retries": 3, "retry_on_status": [429, 503], "use_cookies": true }
  },
  "asmrfree": {
    "base_url": "https://asmrfree.com",
    "path_builder": { "pattern": "/page/{n}/?s={query}", "start": 1, "end": 20, "step": 1 },
    "link_rules": {
      "search_strict_query": true,
      "include_url_patterns": ["^https://asmrfree\\.com/[^/?#]+/?$"],
      "exclude_url_patterns": ["^https://asmrfree\\.com/(?:latest|asmr-actress|video-request|contact-us|category|tag|page)/?$"]
    },
    "dedupe": { "strip_fragment": true, "strip_trailing_slash": true, "ignore_query": true },
    "follow": { "enabled": true, "collect_child_links": false },
    "anti_block": { "min_delay_sec": 1.0, "max_delay_sec": 2.0, "max_retries": 3, "retry_on_status": [403, 429, 503], "use_cookies": true }
  },
  "eporner": {
    "base_url": "https://www.eporner.com",
    "search_template": "{base}/search/{query}/",
    "link_rules": {
      "search_strict_query": false,
      "include_url_patterns": ["^https://www\\.eporner\\.com/video-[^/]+/[^/?#]+/?$"],
      "exclude_url_patterns": []
    },
    "dedupe": { "strip_fragment": true, "strip_trailing_slash": true, "ignore_query": true },
    "follow": { "enabled": true, "collect_child_links": false },
    "anti_block": { "min_delay_sec": 0.7, "max_delay_sec": 1.4, "max_retries": 3, "retry_on_status": [429, 503], "use_cookies": true }
  },
  "bunkr": {
    "base_url": "https://balbums.st",
    "search_template": "{base}/?search={query}",
    "params": { "mode": "broad", "per": "100", "sort": "latest" },
    "link_rules": {
      "search_strict_query": false,
      "include_url_patterns": ["^https://bunkr\\.cr/a/[A-Za-z0-9_-]+/?$"],
      "exclude_url_patterns": []
    },
    "dedupe": { "strip_fragment": true, "strip_trailing_slash": true, "ignore_query": true },
    "follow": { "enabled": false, "collect_child_links": false },
    "anti_block": { "min_delay_sec": 0.8, "max_delay_sec": 1.5, "max_retries": 3, "retry_on_status": [429, 503], "use_cookies": true }
  },
  "coomer": {
    "base_url": "https://official.coomer.com.co",
    "search_template": "{base}/search/{query}/",
    "link_rules": {
      "search_strict_query": false,
      "include_url_patterns": ["^https://official\\.coomer\\.com\\.co/(?:video|album|playlist|model)/[^/?#]+"],
      "exclude_url_patterns": ["^https://official\\.coomer\\.com\\.co/(?:de|fr|es|it|pt|zh|ja|ru|tr)/search/"]
    },
    "dedupe": { "strip_fragment": true, "strip_trailing_slash": true, "ignore_query": true },
    "follow": { "enabled": true, "collect_child_links": false },
    "anti_block": { "min_delay_sec": 0.8, "max_delay_sec": 1.5, "max_retries": 3, "retry_on_status": [429, 503], "use_cookies": true }
  },
  "simpcity": {
    "base_url": "https://simpcity.es",
    "path_builder": { "paths": ["/", "/forums/"], "prefer_query_links": true },
    "follow": { "enabled": false }
  },
  "eroasmr": {
    "base_url": "https://eroasmr.com",
    "search_template": "{base}/?s={query}",
    "link_rules": {
      "search_strict_query": false,
      "include_url_patterns": ["^https://eroasmr\\.com/video/[^/?#]+/?$"],
      "exclude_url_patterns": []
    },
    "dedupe": { "strip_fragment": true, "strip_trailing_slash": true, "ignore_query": true },
    "follow": { "enabled": true, "collect_child_links": false },
    "anti_block": { "min_delay_sec": 0.7, "max_delay_sec": 1.4, "max_retries": 3, "retry_on_status": [429, 503], "use_cookies": true }
  }
}
